---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="p-6 md:p-8 rounded-3xl bg-white border border-zinc-200/40 shadow-[0_4px_20px_rgba(0,0,0,0.02)] mb-8 space-y-6">
    <p class="text-sm tracking-[0.2em] text-zinc-400">RandomTicks Server</p>

    <h1 class="text-4xl font-medium tracking-wide text-zinc-900">
      原版生存 &middot; 红石科技 &middot; 精美建筑
    </h1>

    <p class="max-w-2xl leading-relaxed text-zinc-600">
      RTS 是一个以原版生存为核心的 Minecraft 服务器。
      我们热衷于红石、建筑与拓展玩法，在稳定与克制的氛围中，共同探索方块世界的无限可能。
    </p>
  </section>

  <section class="p-6 md:p-8 rounded-3xl bg-white border border-zinc-200/40 shadow-[0_4px_20px_rgba(0,0,0,0.02)] mb-8 space-y-6">
    <div>
      <a href="/gallery" class="text-[11px] font-mono text-zinc-400 tracking-wider hover:text-zinc-700 transition-colors inline-flex items-center gap-1 group/link">
        服务器日常 / 照相馆
        <span class="inline-block transition-transform duration-200 group-hover/link:translate-x-0.5">&rarr;</span>
      </a>
      <p class="text-xs text-zinc-500 mt-1">定格生存开荒、红石大工程与那些温馨的瞬间。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <div class="md:col-span-2 group relative overflow-hidden rounded-2xl bg-zinc-100 border border-zinc-100 h-64 md:h-80 transition-all duration-300 shadow-[0_2px_8px_rgba(0,0,0,0.01)] hover:border-zinc-200">
        <img
          src="/photos/saneba.jpg"
          alt="日常"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-zinc-950/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="absolute bottom-0 left-0 p-5 text-white">
          <span class="text-[9px] font-mono uppercase tracking-widest bg-white/20 backdrop-blur-sm px-2 py-0.5 rounded">游戏日常</span>
          <h4 class="text-sm font-bold mt-2 font-mono">烛光晚餐</h4>
          <p class="text-[10px] text-zinc-200/90 mt-0.5">三个服务器恶霸。</p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl bg-zinc-100 border border-zinc-100 h-64 md:h-80 transition-all duration-300 shadow-[0_2px_8px_rgba(0,0,0,0.01)] hover:border-zinc-200">
        <img
          src="/photos/shuangrenfengche.jpg"
          alt="建筑"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-zinc-950/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="absolute bottom-0 left-0 p-5 text-white">
          <span class="text-[9px] font-mono uppercase tracking-widest bg-white/20 backdrop-blur-sm px-2 py-0.5 rounded">建筑</span>
          <h4 class="text-sm font-bold mt-2 font-mono">基地一角 · 田园风光</h4>
          <p class="text-[10px] text-zinc-200/90 mt-0.5">前期基地小建筑完工后的合影。</p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl bg-zinc-100 border border-zinc-100 h-48 transition-all duration-300 shadow-[0_2px_8px_rgba(0,0,0,0.01)] hover:border-zinc-200">
        <img
          src="/photos/gududebohetang.jpg"
          alt="日常"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-zinc-950/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="absolute bottom-0 left-0 p-4 text-white">
          <span class="text-[9px] font-mono uppercase tracking-widest bg-white/20 backdrop-blur-sm px-2 py-0.5 rounded">游戏日常</span>
          <h4 class="text-sm font-bold mt-1.5 font-mono">孤独的薄荷糖</h4>
          <p class="text-[10px] text-zinc-200/90 mt-0.5">他又在思考什么呢？</p>
        </div>
      </div>

      <div class="md:col-span-2 group relative overflow-hidden rounded-2xl bg-zinc-100 border border-zinc-100 h-48 transition-all duration-300 shadow-[0_2px_8px_rgba(0,0,0,0.01)] hover:border-zinc-200">
        <img
          src="/photos/kaihuanghezhao.jpg"
          alt="合影"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-zinc-950/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="absolute bottom-0 left-0 p-4 text-white">
          <span class="text-[9px] font-mono uppercase tracking-widest bg-white/20 backdrop-blur-sm px-2 py-0.5 rounded">开荒留念</span>
          <h4 class="text-sm font-bold mt-1.5 font-mono">周六开荒夜 · 全员大合照</h4>
          <p class="text-[10px] text-zinc-200/90 mt-0.5">集体合影，纪念RTS新纪元开启。</p>
        </div>
      </div>

    </div>
  </section>

  <section class="p-6 md:p-8 rounded-3xl bg-white border border-zinc-200/40 shadow-[0_4px_20px_rgba(0,0,0,0.02)] mb-8 space-y-10">
    <h2 class="text-xs tracking-[0.3em] text-zinc-400 uppercase">快速导航</h2>

    <div class="grid grid-cols-2 gap-px bg-zinc-200">
      <a
        href="/members"
        class="flex flex-col gap-1 bg-white px-6 py-5 hover:bg-zinc-50 transition-colors duration-200"
      >
        <span class="text-sm tracking-wider text-zinc-800">成员</span>
        <span class="text-xs text-zinc-400">了解服务器的核心贡献者</span>
      </a>
      <a
        href="/projects"
        class="flex flex-col gap-1 bg-white px-6 py-5 hover:bg-zinc-50 transition-colors duration-200"
      >
        <span class="text-sm tracking-wider text-zinc-800">项目</span>
        <span class="text-xs text-zinc-400">自研插件与开源仓库</span>
      </a>
      <a
        href="/blog"
        class="flex flex-col gap-1 bg-white px-6 py-5 hover:bg-zinc-50 transition-colors duration-200"
      >
        <span class="text-sm tracking-wider text-zinc-800">博客</span>
        <span class="text-xs text-zinc-400">玩家与管理员的日常日志</span>
      </a>
      <a
        href="/join"
        class="flex flex-col gap-1 bg-white px-6 py-5 hover:bg-zinc-50 transition-colors duration-200"
      >
        <span class="text-sm tracking-wider text-zinc-800">加入我们</span>
        <span class="text-xs text-zinc-400">申请加入 RTS 服务器</span>
      </a>
    </div>
  </section>

  <div id="secret-panel" class="hidden opacity-0 transition-opacity duration-500 border-t border-zinc-200/60 bg-white py-8 px-4 relative mt-8">
    <button id="secret-close" class="absolute top-4 right-4 font-mono text-[10px] text-zinc-400 hover:text-zinc-700 transition-colors tracking-wider cursor-pointer">[ Close ]</button>

    <div class="max-w-4xl mx-auto font-mono text-[11px] text-zinc-500 space-y-1">
      <p>[ SYSTEM ] LOG: ENABLING HIDDEN PROTOCOL...</p>
      <p>[ DECRYPT ] COORD: X: 114514 | Y: 64 | Z: 1919810</p>

      <p class="text-red-500/80">[ WARNING ] PROTOCOL_VIOLATION_DETECTED:</p>
      <p class="pl-4">➔ 紫枫: [WARN] 长期处于离线状态，被怀疑已转职为云玩家</p>
      <p class="pl-4">➔ 晓晨: [WARN] 试图通过在群里发梗图来代替红石机器的日常维护</p>
      <p class="pl-4 text-red-500/80">➔ 科技头: [KICKED] 由于连续 72 小时没有上线被踢出服务器</p>
      <p class="pl-4">➔ 薄荷糖: [WARN] 频繁提交官网前端改动，拒绝上游戏干活</p>

      <p class="pt-1 text-zinc-400">[ COUNTER ] ACCIDENT: 距离服务器因为没人维护而停止运转已过去 0 天</p>
    </div>
  </div>

  <script>
    const konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let konamiIndex = 0;

    const panel = document.getElementById('secret-panel');
    const closeBtn = document.getElementById('secret-close');

    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;

      const key = e.key.toLowerCase();
      const expected = konamiCode[konamiIndex].toLowerCase();

      if (key === expected) {
        konamiIndex++;
        if (konamiIndex === konamiCode.length) {
          panel.classList.remove('hidden');
          requestAnimationFrame(() => {
            panel.classList.remove('opacity-0');
          });
          konamiIndex = 0;
        }
      } else {
        konamiIndex = (key === konamiCode[0].toLowerCase()) ? 1 : 0;
      }
    });

    closeBtn.addEventListener('click', () => {
      panel.classList.add('opacity-0');
      konamiIndex = 0;
      setTimeout(() => {
        panel.classList.add('hidden');
      }, 500);
    });
  </script>
</Layout>