---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';
---

<Layout>
  <div class="bg-white flex flex-col items-center justify-center min-h-[70vh]">
    <div class="font-mono text-center">
      <h1 class="text-lg font-bold text-zinc-900 tracking-wider mb-4">{siteConfig.error404.title}</h1>
      <p class="text-sm text-zinc-600 tracking-wide leading-relaxed">{siteConfig.error404.reason}</p>

      <div class="flex flex-wrap justify-center gap-3 mt-8">
      <a
        href="/"
        class="border border-zinc-200/80 text-[11px] px-4 py-1.5 text-zinc-700 hover:bg-black hover:text-white transition-colors duration-200"
      >
        [ {siteConfig.error404.buttons.respawn} ]
      </a>
      <button
        id="btn-call"
        class="border border-zinc-200/80 text-[11px] px-4 py-1.5 text-zinc-700 hover:bg-black hover:text-white transition-colors duration-200 cursor-pointer"
      >
        [ {siteConfig.error404.buttons.callAdmin} ]
      </button>
      <button
        id="btn-rollback"
        class="border border-zinc-200/80 text-[11px] px-4 py-1.5 text-zinc-700 hover:bg-black hover:text-white transition-colors duration-200 cursor-pointer"
      >
        [ {siteConfig.error404.buttons.rollback} ]
      </button>
    </div>
    </div>
  </div>

  <script define:vars={{ siteConfig }}>
    document.getElementById('btn-call').addEventListener('click', () => {
      alert(siteConfig.error404.alerts.callAdmin);
    });

    document.getElementById('btn-rollback').addEventListener('click', () => {
      alert(siteConfig.error404.alerts.rollback);
    });
  </script>
</Layout>
