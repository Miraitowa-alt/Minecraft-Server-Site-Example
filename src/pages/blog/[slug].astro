---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
  <article class="p-6 md:p-8 rounded-3xl bg-white border border-zinc-200/40 shadow-[0_4px_20px_rgba(0,0,0,0.02)] mb-8">
    <div class="border-b border-zinc-100 pb-6 mb-8">
      <div class="text-[11px] font-mono text-zinc-400 tracking-wider">
        <a href="/" class="hover:text-zinc-600 transition-colors">首页</a>
        <span class="mx-1 text-zinc-300">/</span>
        <a href="/blog" class="hover:text-zinc-600 transition-colors">博客</a>
        <span class="mx-1 text-zinc-300">/</span>
        <span class="font-semibold text-zinc-500 max-w-[280px] inline-block truncate align-bottom">
          {post.data.title}
        </span>
      </div>

      <h1 class="text-2xl font-black text-zinc-900 mt-4 tracking-tight">
        {post.data.title}
      </h1>

      <div class="flex items-center gap-3 mt-3 text-xs text-zinc-400 font-mono">
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
          {post.data.pubDate.toISOString().slice(0, 10)}
        </time>
        <span class="text-zinc-200">|</span>
        <span>{post.data.author}</span>
      </div>
    </div>

    <div class="prose prose-zinc prose-sm max-w-none
      prose-headings:font-semibold prose-headings:text-zinc-900 prose-headings:tracking-tight
      prose-h1:text-xl prose-h2:text-lg prose-h3:text-base
      prose-p:text-sm prose-p:text-zinc-700 prose-p:leading-relaxed
      prose-a:text-zinc-800 prose-a:no-underline prose-a:transition-colors hover:prose-a:text-zinc-950
      prose-code:bg-zinc-50 prose-code:text-zinc-700 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-xs prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
      prose-pre:bg-zinc-50/80 prose-pre:border prose-pre:border-zinc-100 prose-pre:rounded-xl prose-pre:shadow-none
      prose-strong:text-zinc-900 prose-strong:font-semibold
      prose-ul:text-sm prose-ul:text-zinc-700 prose-ol:text-sm prose-ol:text-zinc-700
      prose-li:my-0.5
      prose-blockquote:border-l-zinc-200 prose-blockquote:text-zinc-500 prose-blockquote:text-sm
      prose-hr:border-zinc-100
    ">
      <Content />
    </div>

    <div class="mt-10 pt-6 border-t border-zinc-100">
      <a href="/blog" class="text-xs text-zinc-400 hover:text-zinc-600 transition-colors font-mono">
        &larr; 返回博客列表
      </a>
    </div>
  </article>
</Layout>