---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';

const members = siteConfig.members.placeholderMembers;
---

<Layout title="服务器成员 // Members">
  <div class="space-y-10">
    <div class="border-b border-zinc-100 pb-4 mb-6">
      <div class="text-[11px] font-mono text-zinc-400 tracking-wider">
        <a href="/" class="hover:text-zinc-600 transition-colors">首页</a>
        <span class="mx-1 text-zinc-300">/</span>
        <span class="font-semibold text-zinc-500 inline-flex items-center gap-1 group/link">
          成员
        </span>
      </div>
      <p class="text-lg text-zinc-600/90 mt-1">{siteConfig.members.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      {members.map((m, index) => (
        <div class={`relative group p-5 rounded-2xl bg-white border border-zinc-100 shadow-[0_2px_8px_rgba(0,0,0,0.02)] hover:border-zinc-200 transition-all duration-300 h-full flex flex-col justify-between ${index === 2 ? 'border-pink-100 bg-pink-50/[0.15]' : ''}`}>

          <div class="flex items-center gap-3 mb-4">
            <div class="w-11 h-11 rounded-full overflow-hidden border border-zinc-100 bg-zinc-50 flex-shrink-0 relative flex items-center justify-center">

              <div class="absolute inset-0 bg-zinc-200 flex items-center justify-center text-zinc-400 text-xs font-bold font-mono z-0 select-none">
                {m.name[0]}
              </div>

              <img
                src={m.avatar}
                loading="lazy"
                alt={m.name}
                class="w-full h-full object-cover relative z-10 transition-opacity duration-300"
                onerror="this.style.opacity='0'; this.style.pointerEvents='none';"
              />
            </div>

            <div>
              <h3 class="text-sm font-bold text-zinc-900 tracking-wide font-mono">{m.name}</h3>
              <div class="flex flex-wrap gap-1.5 mt-1">
                {m.role.map((r) => (
                  <span class="bg-zinc-100 text-zinc-600 text-[10px] px-2 py-0.5 rounded-sm font-mono">{r}</span>
                ))}
              </div>
            </div>
          </div>

          <p class="text-[11px] text-zinc-600 leading-relaxed mb-6 font-sans flex-grow">
            {m.bio}
          </p>

          <a href={m.bilibili} target="_blank" rel="noopener noreferrer" class="text-[11px] font-medium text-zinc-500 group-hover:text-zinc-900 transition-colors flex items-center gap-1 mt-auto">
            <span>点我进入个人B站</span>
          </a>

          <div class="absolute inset-0 rounded-2xl bg-pink-500/[0.015] opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"></div>
        </div>
      ))}
    </div>
  </div>
</Layout>
