---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="博客 // Blog">
  <section class="p-6 md:p-8 rounded-3xl bg-white border border-zinc-200/40 shadow-[0_4px_20px_rgba(0,0,0,0.02)] mb-8 space-y-8">
    <div class="border-b border-zinc-100 pb-4">
      <div class="text-[11px] font-mono text-zinc-400 tracking-wider">
        <a href="/" class="hover:text-zinc-600 transition-colors">首页</a>
        <span class="mx-1 text-zinc-300">/</span>
        <span class="font-semibold text-zinc-500">博客</span>
      </div>
      <p class="text-base text-zinc-600/90 mt-1">{siteConfig.blog.subtitle}</p>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-sm text-zinc-400 py-12 text-center">暂无文章。</p>
      ) : (
        <ul class="divide-y divide-zinc-100">
          {posts.map((post) => (
            <li class="py-5 first:pt-0 last:pb-0">
              <a href={`/blog/${post.slug}`} class="group block space-y-2 -mx-3 px-3 py-2 rounded-lg hover:bg-zinc-50/50 transition-colors duration-150">
                <div class="flex items-center gap-3 text-xs text-zinc-400 font-mono">
                  <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                    {post.data.pubDate.toISOString().slice(0, 10)}
                  </time>
                  <span class="text-zinc-200">|</span>
                  <span>{post.data.author}</span>
                </div>
                <h2 class="text-sm font-semibold text-zinc-800 group-hover:text-zinc-950 transition-colors duration-150">
                  {post.data.title}
                </h2>
                <p class="text-xs text-zinc-500 leading-relaxed line-clamp-2">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
