---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';

const projects = siteConfig.projects.placeholderProjects;
---

<Layout title="项目成果 // Projects">
  <section class="p-6 md:p-8 rounded-3xl bg-white border border-zinc-200/40 shadow-[0_4px_20px_rgba(0,0,0,0.02)] mb-8">
    <div class="border-b border-zinc-100 pb-4 mb-8">
      <div class="text-[11px] font-mono text-zinc-400 tracking-wider">
        <a href="/" class="hover:text-zinc-600 transition-colors">首页</a>
        <span class="mx-1 text-zinc-300">/</span>
        <span class="font-semibold text-zinc-500">项目</span>
      </div>
      <p class="text-base text-zinc-600/90 mt-1">{siteConfig.projects.subtitle}</p>
    </div>

    <ul class="divide-y divide-zinc-100">
      {projects.map((p) => (
        <li class="py-5 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-semibold text-zinc-800 font-mono">
              {p.title}
            </h3>
            <div class="flex flex-wrap gap-1.5 mt-2">
              {p.tags.map((tag) => (
                <span class="inline-block text-[10px] font-mono text-zinc-400 bg-zinc-50 border border-zinc-100 px-1.5 py-0.5 rounded">
                  {tag}
                </span>
              ))}
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed mt-2.5 max-w-xl">
              {p.description}
            </p>
          </div>
          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-[11px] font-mono text-zinc-500 bg-white border border-zinc-200 px-3 py-1.5 rounded-lg hover:bg-zinc-950 hover:text-white hover:border-zinc-950 transition-all duration-200 flex-shrink-0"
          >
            <span>GitHub</span>
            <span class="text-[9px]">&nearr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
