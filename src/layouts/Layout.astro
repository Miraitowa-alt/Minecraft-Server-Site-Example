---
import { siteConfig } from '../config';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const displayTitle = title ? `${title} // ${siteConfig.name}` : siteConfig.name;
const currentPath = Astro.url.pathname;

const navClass = (href: string) =>
  currentPath === href
    ? "font-semibold text-zinc-950"
    : "hover:text-zinc-950 transition-colors";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={siteConfig.description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{displayTitle}</title>
  </head>
  <body class="bg-zinc-100/70 min-h-screen flex flex-col selection:bg-pink-500 selection:text-white">

    <header class="w-full bg-white border-b border-zinc-200/50 sticky top-0 z-50">
      <div class="max-w-5xl w-full mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-12 h-12 flex items-center justify-center border border-zinc-200 bg-white rounded-xl shadow-sm group-hover:border-zinc-300 transition-colors">
            <img src="/logo.png" alt={siteConfig.name} class="w-10 h-10 object-contain rounded-lg" />
          </div>
          <div class="flex flex-col leading-none">
            <span class="text-sm font-bold tracking-wide text-zinc-900">{siteConfig.name}</span>
            <span class="text-[10px] text-zinc-400 font-normal tracking-wider mt-0.5">{siteConfig.tagline}</span>
          </div>
        </a>

        <div class="flex items-center gap-4">
          <nav class="flex items-center gap-5 text-xs font-medium text-zinc-600">
            {siteConfig.navigation.map((item) => (
              <a href={item.href} class={navClass(item.href)}>{item.name}</a>
            ))}
          </nav>

          <div class="flex items-center gap-1.5 ml-1">
            <a href={siteConfig.social.bilibili} target="_blank" rel="noopener noreferrer" title="Bilibili" class="border border-zinc-200/60 rounded-xl p-1.5 text-zinc-400 hover:text-zinc-700 hover:border-zinc-300 transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><polyline points="8 21 12 17 16 21" /></svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="max-w-5xl w-full mx-auto px-6 py-12 flex-grow">
      <slot />
    </main>

    <footer class="max-w-5xl w-full mx-auto px-6 py-10 border-t border-zinc-200/40 text-center">
      <p class="text-[10px] font-mono text-zinc-400 tracking-wider">
        &copy; {siteConfig.footer.copyright}
      </p>
    </footer>

    <script define:vars={{ siteConfig }}>
      const originalTitle = document.title;
      const items = siteConfig.afk.items;
      let afkTimer = null;
      let lootBag = {};

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          lootBag = {};
          document.title = siteConfig.afk.messages.afk;
          afkTimer = setInterval(() => {
            const item = items[Math.floor(Math.random() * items.length)];
            const amount = Math.floor(Math.random() * 5) + 1;
            lootBag[item] = (lootBag[item] || 0) + amount;
            document.title = `📦 [AFK] ${item} +${amount}...`;
          }, 3000);
        } else {
          clearInterval(afkTimer);
          afkTimer = null;
          document.title = siteConfig.afk.messages.online;

          if (Object.keys(lootBag).length > 0) {
            const lootList = Object.entries(lootBag)
              .map(([item, count]) => `• ${item} x ${count}`)
              .join('\n');
            alert(
              `${siteConfig.afk.messages.lootTitle}\n\n${siteConfig.afk.messages.lootIntro}\n----------------------------------------\n${lootList}\n----------------------------------------\n${siteConfig.afk.messages.lootOutro}`
            );
          }

          lootBag = {};
          setTimeout(() => {
            document.title = originalTitle;
          }, 1500);
        }
      });
    </script>
  </body>
</html>
